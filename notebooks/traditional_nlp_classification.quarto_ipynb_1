     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Model trained.\n"
     ]
    }
   ],
   "source": [
    "from sklearn.linear_model import LogisticRegression\n",
    "\n",
    "clf = LogisticRegression(max_iter=1000, C=1.0, random_state=42)\n",
    "clf.fit(X_train, y_train)\n",
    "\n",
    "print(\"Model trained.\")"
   ]
