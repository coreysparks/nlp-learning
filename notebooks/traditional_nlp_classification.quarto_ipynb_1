   "source": [
    "import re # for regular expressions to clean text\n",
    "import nltk # natural language toolkit for preprocessing\n",
    "\n",
    "# Download the required NLTK data files the first time this runs.\n",
    "# These are small reference datasets (stopword lists, tokenizers, lemma rules).\n",
    "# the punkt_tab tokenizer is a faster version of the standard punkt tokenizer.\n",
    "# wordnet is needed for lemmatization. lemmatization is the process of reducing words to their base form (e.g. \"running\" -> \"run\").\n",
    "nltk.download(\"stopwords\", quiet=True)\n",
    "nltk.download(\"punkt\", quiet=True)\n",
    "nltk.download(\"punkt_tab\", quiet=True)\n",
    "nltk.download(\"wordnet\", quiet=True)\n",
    "\n",
    "from nltk.corpus import stopwords\n",
    "from nltk.tokenize import word_tokenize\n",
    "from nltk.stem import WordNetLemmatizer\n",
    "\n",
    "STOPWORDS = set(stopwords.words(\"english\"))\n",
    "lemmatizer = WordNetLemmatizer() # create a lemmatizer instance to use in the preprocess function\n",
    "\n",
    "# Define a function that takes a raw complaint text and returns a cleaned version.\n",
    "def preprocess(text: str) -> str:\n",
    "    \"\"\"Clean a single complaint string and return a processed version.\"\"\"\n",
    "    # Step 1: lowercase everything\n",
    "    text = text.lower()\n",
    "\n",
    "    # Step 2: strip punctuation and digits, keep only letters and spaces\n",
    "    text = re.sub(r\"[^a-z\\s]\", \" \", text)\n",
    "\n",
    "    # Step 3: tokenize into individual words\n",
    "    tokens = word_tokenize(text)\n",
    "\n",
    "    # Step 4: remove stopwords and very short tokens (length <= 2)\n",
    "    tokens = [t for t in tokens if t not in STOPWORDS and len(t) > 2]\n",
    "\n",
    "    # Step 5: lemmatize — reduce each word to its dictionary base form\n",
    "    tokens = [lemmatizer.lemmatize(t) for t in tokens]\n",
    "\n",
    "    return \" \".join(tokens)\n",
    "\n",
    "\n",
    "# Apply the preprocessing function to every row in the DataFrame.\n",
    "df[\"clean_text\"] = df[\"complaint_text\"].apply(preprocess)\n",
    "\n",
    "# Compare original vs. cleaned for a few rows so we can see what changed.\n",
    "for i, row in df[[\"complaint_text\", \"clean_text\"]].head(5).iterrows():\n",
    "    print(\"ORIGINAL:\", row[\"complaint_text\"])\n",
    "    print(\"CLEANED: \", row[\"clean_text\"])\n",
    "    print()"
   ]
  },
