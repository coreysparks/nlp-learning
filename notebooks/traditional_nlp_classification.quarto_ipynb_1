    "# Build a lookup: category -> minimum threshold.\n",
    "# Use 0.0 as fallback for any category where we found no threshold above.\n",
    "threshold_map = {\n",
    "    row[\"category\"]: (row[\"threshold\"] if row[\"threshold\"] is not None else 0.0)\n",
    "    for _, row in thresholds_df.iterrows()\n",
    "}\n",
    "\n",
    "def predict_with_thresholds(proba_row, classes, threshold_map):\n",
    "    \"\"\"Return the predicted label or 'Review needed' if no class clears its threshold.\"\"\"\n",
    "    best_class = classes[np.argmax(proba_row)]\n",
    "    best_prob  = proba_row.max()\n",
    "    min_thresh = threshold_map.get(best_class, 0.0)\n",
    "    if best_prob >= min_thresh:\n",
    "        return best_class\n",
    "    return \"Review needed\"\n",
    "\n",
    "y_pred_tuned = np.array([\n",
    "    predict_with_thresholds(row, classes, threshold_map)\n",
    "    for row in y_proba\n",
    "])\n",
    "\n",
    "# Summarize what changed.\n",
    "n_deferred = (y_pred_tuned == \"Review needed\").sum()\n",
    "n_total    = len(y_pred_tuned)\n",
    "print(f\"Complaints auto-labeled : {n_total - n_deferred} / {n_total}  ({(n_total-n_deferred)/n_total:.1%})\")\n",
    "print(f\"Deferred to human review: {n_deferred} / {n_total}  ({n_deferred/n_total:.1%})\")"
